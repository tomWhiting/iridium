{
  "name": "@iridium-editor/syntax-worker",
  "version": "0.1.1",
  "type": "module",
  "description": "Web Worker for tree-sitter syntax highlighting - moves parsing off the main thread",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "test": "bun test src/"
  },
  "keywords": [
    "syntax-highlighting",
    "tree-sitter",
    "web-worker",
    "editor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomWhiting/iridium"
  },
  "peerDependencies": {
    "@iridium-editor/core": "^0.2.0"
  },
  "dependencies": {
    "web-tree-sitter": "0.25.6"
  },
  "devDependencies": {
    "@iridium-editor/core": "file:../core",
    "typescript": "^5.9.3"
  }
}
