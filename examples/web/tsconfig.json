{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@iridium/core": ["../../packages/@iridium/core/src/controller/index.ts"],
      "@iridium/core/*": ["../../packages/@iridium/core/src/*"],
      "web-tree-sitter": ["./node_modules/web-tree-sitter"]
    }
  },
  "include": ["src"]
}
