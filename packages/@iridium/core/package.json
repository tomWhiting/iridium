{
  "name": "@iridium-editor/core",
  "version": "0.2.0",
  "type": "module",
  "description": "Core TypeScript modules for Iridium GPU-accelerated text editor",
  "exports": {
    ".": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./syntax": {
      "types": "./dist/syntax/index.d.ts",
      "default": "./dist/syntax/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./palette": {
      "types": "./dist/palette/index.d.ts",
      "default": "./dist/palette/index.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "default": "./dist/history/index.js"
    },
    "./worker-client": {
      "types": "./dist/worker/client.d.ts",
      "default": "./dist/worker/client.js"
    },
    "./worker-protocol": {
      "types": "./dist/worker/protocol.d.ts",
      "default": "./dist/worker/protocol.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "keywords": [
    "editor",
    "text-editor",
    "gpu",
    "webgpu",
    "syntax-highlighting",
    "tree-sitter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomWhiting/iridium.git"
  },
  "peerDependencies": {
    "iridium-bindings": ">=0.2.0",
    "@iridium-editor/syntax-worker": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@iridium-editor/syntax-worker": {
      "optional": true
    }
  },
  "dependencies": {
    "web-tree-sitter": "0.25.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "main": "./dist/controller/index.js",
  "types": "./dist/controller/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "test": "bun test src/"
  }
}
