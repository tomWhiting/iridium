#!/bin/sh
# Terminal entry point, installed as both `ir` and `iridium`.
# The desktop app is launched from Applications or Finder.
set -eu

# Keep existing terminal invocations working after making them the default.
case "${1-}" in
--tui | -t) shift ;;
esac

here="$(dirname "$0")"
tui="$here/iridium-tui"
if [ ! -x "$tui" ]; then
    echo "iridium: the terminal executable is missing at $tui" >&2
    echo "Run apps/iridium-desktop/bundle/install.sh to install both apps." >&2
    exit 1
fi
exec "$tui" "$@"
